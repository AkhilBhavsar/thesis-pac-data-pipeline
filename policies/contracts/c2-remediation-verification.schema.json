{
  "$id": "https://thesis-pac.local/contracts/c2-remediation-verification.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C2 Recovery Verification Evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "condition": {
      "const": "C2"
    },
    "scenario_id": {
      "enum": [
        "schema_break",
        "pii_exposure",
        "freshness_breach",
        "quality_regression",
        "policy_false_positive"
      ]
    },
    "run_key": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "automatic",
        "manual"
      ]
    },
    "automatic_remediation_permitted": {
      "type": "boolean"
    },
    "source_remediation_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_remediation_result_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_evidence_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "verification_completed_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "schema_contract",
          "privacy",
          "freshness",
          "quality",
          "runtime",
          "release_policy",
          "manual_policy_review"
        ]
      }
    },
    "check_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "policy_id"
        ],
        "properties": {
          "check": {
            "enum": [
              "schema_contract",
              "privacy",
              "freshness",
              "quality",
              "runtime",
              "release_policy",
              "manual_policy_review"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "PENDING"
            ]
          },
          "policy_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^PAC-[A-Z]+-[0-9]{3}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "policy_input": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_input_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_input_contract_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_bundle_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy_evaluation_ms": {
      "type": "number",
      "minimum": 0
    },
    "policy_allow": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "triggered_policy_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PAC-[A-Z]+-[0-9]{3}$"
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "verification_status": {
      "enum": [
        "PASS",
        "FAIL",
        "MANUAL_REQUIRED"
      ]
    },
    "promotion_requested": {
      "const": true
    },
    "promotion_blocked": {
      "type": "boolean"
    },
    "recommended_fallback_action": {
      "oneOf": [
        {
          "enum": [
            "quarantine",
            "stop_promotion",
            "manual_review"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_result_emitted": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "condition",
    "scenario_id",
    "run_key",
    "mode",
    "automatic_remediation_permitted",
    "source_remediation_plan_sha256",
    "source_remediation_result_sha256",
    "source_evidence_sha256",
    "verification_started_at_utc",
    "verification_completed_at_utc",
    "required_checks",
    "check_results",
    "policy_input",
    "policy_input_sha256",
    "policy_input_contract_sha256",
    "policy_bundle_sha256",
    "policy_evaluation_ms",
    "policy_allow",
    "triggered_policy_ids",
    "violations",
    "verification_status",
    "promotion_requested",
    "promotion_blocked",
    "recommended_fallback_action",
    "verified_result_emitted"
  ]
}
