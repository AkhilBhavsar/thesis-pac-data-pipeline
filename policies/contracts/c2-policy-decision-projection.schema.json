{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesis-pac.local/contracts/c2-policy-decision-projection.schema.json",
  "title": "C2 Policy Decision Projection",
  "description": "Explicit provenance-linked projection of one blocked C1 Policy-as-Code DENY into the C2 bounded-remediation condition. The projection preserves detection identity and policy evidence while enabling only the C2 remediation controls defined by the C2 remediation catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "condition",
    "recorded_at_utc",
    "run_key",
    "scenario_id",
    "evaluation_stage",
    "promotion_requested",
    "decision",
    "allow",
    "triggered_policy_ids",
    "controls",
    "measurement",
    "projection"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "condition": {
      "const": "C2"
    },
    "recorded_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "run_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scenario_id": {
      "enum": [
        "schema_break",
        "pii_exposure",
        "freshness_breach",
        "quality_regression",
        "policy_false_positive"
      ]
    },
    "evaluation_stage": {
      "enum": [
        "pre",
        "post"
      ]
    },
    "promotion_requested": {
      "const": true
    },
    "decision": {
      "const": "DENY"
    },
    "allow": {
      "const": false
    },
    "triggered_policy_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_as_code_required",
        "self_healing_permitted",
        "automatic_remediation_permitted"
      ],
      "properties": {
        "policy_as_code_required": {
          "const": true
        },
        "self_healing_permitted": {
          "const": true
        },
        "automatic_remediation_permitted": {
          "type": "boolean"
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_requested",
        "promotion_blocked"
      ],
      "properties": {
        "promotion_requested": {
          "const": true
        },
        "promotion_blocked": {
          "const": true
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_condition",
        "source_policy_decision_sha256",
        "source_input_sha256",
        "source_policy_bundle_sha256",
        "source_self_healing_permitted",
        "source_automatic_remediation_permitted"
      ],
      "properties": {
        "method": {
          "const": "c1_deny_to_c2_bounded_remediation_v1"
        },
        "source_condition": {
          "const": "C1"
        },
        "source_policy_decision_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_policy_bundle_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_self_healing_permitted": {
          "const": false
        },
        "source_automatic_remediation_permitted": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "schema_break"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation_stage": {
            "const": "pre"
          },
          "controls": {
            "properties": {
              "automatic_remediation_permitted": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "pii_exposure"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation_stage": {
            "const": "pre"
          },
          "controls": {
            "properties": {
              "automatic_remediation_permitted": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "freshness_breach"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation_stage": {
            "const": "post"
          },
          "controls": {
            "properties": {
              "automatic_remediation_permitted": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "quality_regression"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation_stage": {
            "const": "post"
          },
          "controls": {
            "properties": {
              "automatic_remediation_permitted": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scenario_id": {
            "const": "policy_false_positive"
          }
        },
        "required": [
          "scenario_id"
        ]
      },
      "then": {
        "properties": {
          "evaluation_stage": {
            "const": "pre"
          },
          "controls": {
            "properties": {
              "automatic_remediation_permitted": {
                "const": false
              }
            }
          }
        }
      }
    }
  ]
}
