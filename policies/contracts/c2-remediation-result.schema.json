{
  "$id": "https://thesis-pac.local/contracts/c2-remediation-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "terminal_state": {
            "const": "RECOVERED"
          }
        }
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "SUCCEEDED"
          },
          "self_healing_performed": {
            "const": true
          },
          "verification": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "automatic_remediation_performed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "attempt_count": {
            "minimum": 1
          },
          "mode": {
            "const": "automatic"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "manual"
          }
        }
      },
      "then": {
        "properties": {
          "attempt_count": {
            "const": 0
          },
          "automatic_remediation_performed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_state": {
            "const": "PENDING_VERIFICATION"
          }
        }
      },
      "then": {
        "properties": {
          "execution_status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "TIMED_OUT"
            ]
          },
          "recovery_time_ms": {
            "type": "null"
          },
          "self_healing_performed": {
            "const": false
          },
          "verification": {
            "properties": {
              "evidence_sha256": {
                "type": "null"
              },
              "status": {
                "const": "NOT_RUN"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terminal_state": {
            "const": "RECOVERED"
          }
        }
      },
      "then": {
        "properties": {
          "recovery_time_ms": {
            "minimum": 0,
            "type": "number"
          }
        }
      }
    }
  ],
  "properties": {
    "action": {
      "enum": [
        "retry",
        "rollback",
        "quarantine",
        "redact_republish",
        "stop_promotion",
        "manual_review"
      ]
    },
    "action_duration_ms": {
      "minimum": 0,
      "type": "number"
    },
    "attempt_count": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "automatic_remediation_performed": {
      "type": "boolean"
    },
    "canonical_mutation_performed": {
      "const": false
    },
    "condition": {
      "const": "C2"
    },
    "execution_status": {
      "enum": [
        "NOT_RUN",
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT"
      ]
    },
    "fault_detected_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "mode": {
      "enum": [
        "automatic",
        "manual"
      ]
    },
    "promotion_recheck_required": {
      "const": true
    },
    "recovery_time_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "remediation_completed_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "remediation_started_at_utc": {
      "format": "date-time",
      "type": "string"
    },
    "run_key": {
      "minLength": 1,
      "type": "string"
    },
    "scenario_id": {
      "enum": [
        "schema_break",
        "pii_exposure",
        "freshness_breach",
        "quality_regression",
        "policy_false_positive"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "self_healing_performed": {
      "type": "boolean"
    },
    "source_remediation_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "terminal_state": {
      "enum": [
        "PENDING_VERIFICATION",
        "RECOVERED",
        "QUARANTINED",
        "MANUAL_REVIEW",
        "FAILED_SAFE"
      ]
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "evidence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "const": true
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL"
          ]
        }
      },
      "required": [
        "required",
        "status",
        "evidence_sha256"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "condition",
    "scenario_id",
    "run_key",
    "source_remediation_plan_sha256",
    "mode",
    "action",
    "attempt_count",
    "execution_status",
    "verification",
    "terminal_state",
    "fault_detected_at_utc",
    "remediation_started_at_utc",
    "remediation_completed_at_utc",
    "action_duration_ms",
    "recovery_time_ms",
    "promotion_recheck_required",
    "canonical_mutation_performed",
    "self_healing_performed",
    "automatic_remediation_performed"
  ],
  "title": "C2 Bounded Remediation Result",
  "type": "object"
}
