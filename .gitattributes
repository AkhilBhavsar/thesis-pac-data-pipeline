# Normalise text files
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf

# Configuration and governance
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.rego text eol=lf
*.tf text eol=lf
*.tfvars text eol=lf
*.md text eol=lf

# Data files
*.csv text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary
